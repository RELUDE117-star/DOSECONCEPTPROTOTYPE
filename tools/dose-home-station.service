# DOSE Home Station — systemd USER unit for the kiosk account (rjarv1).
#
# WHY THIS EXISTS
# A device audit on 2026-09-17 found the app had no service of any kind. It
# was started by an x-terminal-emulator running DOSE.sh out of a *Desktop*
# folder, while the application itself lived in ~/dose-home-station — two
# different trees, no restart on crash, no start at boot, no captured logs,
# and the whole thing died with its terminal window. On a medication
# dispenser that is not an acceptable way to run.
#
# This is a USER unit, not a system one, because the app is a Tkinter kiosk
# UI that needs the logged-in graphical session. It is bound to
# graphical-session.target so it starts when the desktop comes up and stops
# when it goes away.
#
# INSTALL:  bash tools/install_service.sh
# (run it as rjarv1 on the Pi — see that script for what it does)

[Unit]
Description=DOSE Home Station (medication dispenser + voice assistant)
Documentation=https://github.com/relude117-star/doseconceptprototype
PartOf=graphical-session.target
After=graphical-session.target

# Restart on crash, but do not loop forever: 5 starts in 5 minutes and it
# stays down, so a boot-looping app is visible as a failed unit instead of
# silently thrashing the SD card and the USB audio stack.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/dose-home-station

# The launcher installs deps/models, tunes the CPU governor, then execs
# python3 dose_app.py. Keep this pointing at the APP directory's copy —
# the Desktop copy is the ambiguity this unit exists to remove.
ExecStartPre=/bin/mkdir -p %h/dose-home-station/logs
ExecStart=/bin/bash %h/dose-home-station/DOSE.sh

Restart=always
RestartSec=5

# The kiosk display. This station runs a WAYLAND session
# (loginctl: Type=wayland) with XWayland behind it, and the app's own
# environment carries BOTH — DISPLAY=:0 and WAYLAND_DISPLAY=wayland-0.
# Tkinter goes through XWayland, so DISPLAY is the one that matters, but
# passing both means anything that prefers Wayland finds it too.
# XDG_RUNTIME_DIR is supplied by systemd for a user unit.
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XAUTHORITY=%h/.Xauthority
# DOSE.sh runs `clear`, which exits non-zero with no TERM and used to
# trip the launcher's ERR trap the instant the service started. DOSE.sh
# now tolerates that on its own; this is the belt to that braces, and
# costs nothing.
Environment=TERM=dumb
# PIN THE MICROPHONE. This station exposes TWO USB capture devices:
# card 5 is the AIRHUG (the real microphone) and card 4 is a "USB
# Composite Device" that advertises capture and hears essentially
# nothing. Selection was otherwise inferred at runtime, and it has been
# observed getting it wrong — an orphaned `arecord -D plughw:4,0` was
# found on the device, left by a crashed instance recording from the
# wrong card. A demo is not the moment to discover that.
# Check with `arecord -l` if the hardware ever changes.
Environment=DOSE_MIC_CARD=5,0

# SIGTERM to the whole group, and give the app time to release the USB
# audio device before anything harsher. A capture killed with SIGKILL does
# not run its cleanup and strands the ALSA PCM — that is exactly the fault
# this audit found inside the app, and it applies just as much to how we
# stop the app itself.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20

# DOSE.sh itself tees both streams into logs/dose.log (appending, with
# rotation). If this unit ALSO appended to that file we would get every
# line twice. So the unit's copy goes to the journal instead: two views
# of the same run, no duplication, and `journalctl --user -u
# dose-home-station` works whether or not the file survived.
#
# It used to be append: to that same path, and on 2026-09-18 a live
# check found no such file after seven minutes of running — that is why
# the launcher now owns the log rather than trusting this line.
StandardOutput=journal
StandardError=journal

[Install]
# ── THE LINE THAT MEANT IT NEVER STARTED AT BOOT ────────────────────
#
# This said `WantedBy=graphical-session.target` alone, and on
# 2026-09-19 a cold-boot test found the station DID NOT COME UP:
#
#     INSTANCES AFTER COLD BOOT: 0
#     service: inactive
#     memory available: 3401 MB
#
# Three and a half gigabytes free is a board running nothing. Pull
# the plug on this cabinet and it came back silent.
#
# graphical-session.target is a target a desktop environment is meant
# to activate. This board's compositor does not, and the device said
# so plainly once anybody asked:
#
#     is graphical-session.target ever reached:  inactive
#     is default.target reached:                 active
#
# So the unit was `enabled` — for a moment that never arrives. The
# unit's own state named it too, in fields nobody had read:
#
#     ActiveEnterTimestamp=  (empty)
#     journalctl:            -- No entries --
#
# ENABLED AND NEVER STARTED. Not failed, not crashed — never
# attempted, in any boot, ever. A unit that has never run has no log,
# and "no entries" reads exactly like "nothing went wrong".
#
# It worked all this time because every start was a MANUAL one:
# `systemctl --user restart`, inside a session that was already up,
# by me. CLAUDE.md has said "systemd is the ONLY start path" since
# September 17 and the path was never automatic. Nobody had tested
# the one thing a person actually does — pull the plug — because
# every restart test was a service restart or a kill -9.
#
# default.target is what a LINGERING user manager reaches at boot.
# Lingering is the other half and is not set by this file:
#
#     sudo loginctl enable-linger rjarv1
#
# without which rjarv1's systemd manager only exists while somebody
# is logged in. Verified together: one instance, 20 seconds after a
# cold boot, in cgroup .../dose-home-station.service.
#
# graphical-session.target stays alongside, so nothing is taken away
# from a system where it does work.
#
# AND DO NOT ADD AN ExecStartPre THAT WAITS FOR THE DISPLAY. I tried;
# the quoted value contained a newline and systemd rejected the whole
# file — "Unbalanced quoting ... unit will not be started" — which
# turned "a unit nothing wants" into "a unit that will not parse".
# Restart=always with RestartSec=5 already covers a compositor that
# is not up yet, and StartLimitBurst keeps that from thrashing. This
# is the one file on the board that, if malformed, means the cabinet
# never starts.
WantedBy=default.target graphical-session.target
