# A GitHub token for the audit "SEND TO GITHUB" button lives on the
# device only. This repository is public; a committed token is a
# revoked token.
github_token
*.token
audit-*.txt

# Claude dev access: NEVER commit private keys or the sanitized status.
# The PUBLIC key file tools/claude_dev_authorized_keys IS committed on
# purpose (public keys are safe); everything below stays local.
*_ed25519
*_ed25519.pub
id_*
!tools/claude_dev_authorized_keys
claude-bootstrap-status.json
claude-bootstrap/
diagnostics/
*.wav
