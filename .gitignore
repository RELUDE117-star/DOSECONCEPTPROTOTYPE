__pycache__/
*.pyc
*.pyo
qr_codes/
.venv/
*.egg-info/
dist/
build/
node_modules/
package-lock.json
package.json

# A GitHub token for the audit "SEND TO GITHUB" button lives on the
# device only. This repository is public; a committed token is a
# revoked token.
github_token
*.token
audit-*.txt

# Cloud STT credentials. These live on the DEVICE and are read from
# ~/dose-home-station/ at runtime — never from this repository, which is
# public. tests/test_egress.py fails the build if any of these stop
# being ignored, because a committed key is a revoked key and a leaked
# one is somebody else spending your free tier.
groq_key
hf_token
*_key
*_token
*_token.txt
.env
.env.*
# The Mac speech server's pairing file: its LAN address on line one and
# a BEARER TOKEN on line two. It matched none of the patterns above —
# not *_key, not *_token — because it is named for what it is rather
# than for what it holds, and the deploy job that writes it said so:
#
#     git-ignored: CHECK THIS
#
# It has never been committed. That is luck, not design, and this
# repository is public.
dose_server.conf
*.conf

# THE MEDICATION DATA, which is the most sensitive thing this project
# touches and was not ignored at all. It is what a named person takes,
# when, and whether they took it — health data about one identifiable
# human being, in a PUBLIC repository.
#
# Nothing has been committed. Again, that is luck: the device writes
# med_data.json into the app directory, the updater is careful never to
# overwrite it, and every backup and export it makes sits beside it
# under a name nothing here covered.
#
# The credential rules above exist because a leaked token costs money.
# This one costs somebody their privacy, and it should have been the
# first line in this file rather than an afterthought found by a test.
med_data.json
med_data.json.*
adherence_log.json
adherence_log.json.*
learning.json
calibration.json
*.bak
# Recordings and transcripts: what was said in this person's kitchen.
voice/
*.wav
turns.jsonl

# Per-device runtime state, not source. cloud_budget.json is the record
# of how much free quota this station has used; it is meaningless
# anywhere else and would cause a device to inherit another's count.
cloud_budget.json

# Claude dev access: NEVER commit private keys or the sanitized status.
# The PUBLIC key file tools/claude_dev_authorized_keys IS committed on
# purpose (public keys are safe); everything below stays local.
*_ed25519
*_ed25519.pub
id_*
!tools/claude_dev_authorized_keys
claude-bootstrap-status.json
claude-bootstrap/
diagnostics/
*.wav

# --- private key material: NEVER committable (belt and braces) ---
# Filename patterns (the .pub public halves are deliberately allowed
# back in below, because a public key grants nothing and the Pi needs it).
*_rsa
*_dsa
*_ecdsa
*_ed25519
*id_rsa*
*id_dsa*
*id_ecdsa*
*id_ed25519*
*.pem
*.key
*.p12
*.pfx
id_*
!*.pub
!tools/claude_dev_authorized_keys

# Device-local marker: when the dependency pass last ran. Per-device
# state, not source.
.deps_checked

# The auto-update brake's state: how many restarts one remote hash has
# already caused, and when the last one was. Per-device by definition —
# committing it would hand every station another device's counter.
update_state.json
